rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Perfil de cada usuário logado (criado automaticamente no cadastro)
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Bloqueia o cliente de se promover a admin (isAdmin só pelo console)
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('isAdmin', false) == false;
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false);
    }

    // Cardápio: só quem está logado lê, só o admin cadastra/edita/exclui
    match /products/{productId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Dados de recebimento (Pix/banco): logados leem, só o admin altera
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Aparelhos do admin que recebem avisos em segundo plano
    match /adminTokens/{tokenId} {
      allow read, write: if isAdmin();
    }

    // Pedidos: cliente cria e lê só os próprios; admin lê e atualiza todos
    match /orders/{orderId} {
      // pedidos só entre 8h e 18h (horário de Brasília = 11h às 21h UTC)
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId
        && request.time.hours() >= 11 && request.time.hours() < 21;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      // admin atualiza tudo; o cliente só pode cancelar o próprio pedido que ainda aguarda pagamento
      allow update: if isAdmin() || (
        request.auth != null
        && request.auth.uid == resource.data.userId
        && resource.data.status == 'aguardando_pagamento'
        && request.resource.data.status == 'cancelado'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      );
    }
  }
}
